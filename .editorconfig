root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

# Vendored from upstream at a pinned commit (SYNC.md): do not reformat, the
# anchor check compares these against the image.
[chart/files/hotfixes/**.py]
indent_size = 4
trim_trailing_whitespace = false
